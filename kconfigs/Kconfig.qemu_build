# SPDX-License-Identifier: copyleft-next-0.3.1
#
# QEMU Build Configuration
#
# This file manages QEMU binary selection and build options for kdevops.
# There are three scenarios for QEMU usage:
#
# 1. QEMU_BUILD=y (kdevops builds QEMU)
#    - kdevops clones, builds, and installs QEMU to /usr/local/bin/
#    - QEMU_USE_DEVELOPMENT_VERSION is automatically set to y
#    - Use case: Need specific QEMU features (NVMe, CXL, custom patches)
#
# 2. QEMU_BUILD=n, QEMU_USE_DEVELOPMENT_VERSION=y (manually built QEMU)
#    - User built QEMU themselves outside kdevops
#    - Binary expected at /usr/local/bin/qemu-system-*
#    - Use case: Custom QEMU build workflow, testing local patches
#
# 3. QEMU_BUILD=n, QEMU_USE_DEVELOPMENT_VERSION=n (distro QEMU)
#    - Use distribution-provided QEMU package
#    - Binary location is distro-specific (/usr/bin/, /usr/libexec/, etc.)
#    - Use case: Standard kernel testing without special QEMU features
#
# See docs/qemu-configuration.md for detailed explanation.

config QEMU_BUILD
	bool "Should we build QEMU for you?"
	output yaml
	select NEEDS_LOCAL_DEVELOPMENT_PATH
	help
	  Enable this to have kdevops clone, build, and install QEMU from
	  source on your localhost. This is useful when your distribution's
	  QEMU package lacks features you need (e.g., NVMe, CXL emulation,
	  or custom patches).

	  When enabled, QEMU will be installed to /usr/local/bin/ and
	  QEMU_USE_DEVELOPMENT_VERSION will be automatically set.

	  If you've already built QEMU manually, say N here and enable
	  QEMU_USE_DEVELOPMENT_VERSION instead.

if QEMU_BUILD

choice
	prompt "QEMU git URL to use"
	default QEMU_BUILD_UPSTREAM

config QEMU_BUILD_UPSTREAM
	bool "https://gitlab.com/qemu-project/qemu.git"
	help
	  Select this option if you want to use the upstream QEMU git repo.

config QEMU_BUILD_JIC23
	bool "https://gitlab.com/jic23/qemu.git"
	help
	  Select this option if you want to use Cameron's QEMU git repo.
	  This has a few CXL bells and whistles which are not yet upstream.

config QEMU_BUILD_MANUAL
	bool "Custom QEMU git URL"
	help
	  Select this option if you want to specify your own git URL.

endchoice

config QEMU_BUILD_GIT
	string "Git tree for QEMU to clone on localhost"
	output yaml
	default "/mirror/qemu.git" if USE_LOCAL_LINUX_MIRROR && QEMU_BUILD_UPSTREAM || QEMU_BUILD_MANUAL
	default "/mirror/qemu-jic23.git" if USE_LOCAL_LINUX_MIRROR && QEMU_BUILD_JIC23
	default DEFAULT_QEMU_GITHUB_HTTPS_URL if !USE_LOCAL_LINUX_MIRROR && QEMU_BUILD_UPSTREAM || QEMU_BUILD_MANUAL
	default DEFAULT_QEMU_JIC23_GITHUB_HTTPS_URL if !USE_LOCAL_LINUX_MIRROR && QEMU_BUILD_JIC23
	help
	  This is the git URL to use to clone and then build QEMU for you on
	  your localhost.

config QEMU_BUILD_GIT_DATA_PATH
	string "The destination directory where to clone the QEMU git tree"
	output yaml
	default "{{local_dev_path}}/qemu"
	help
	  This is the target location of where to clone the above git tree.
	  Note that {{local_dev_path}} corresponds to the location set by the
	  configuration option CONFIG_NEEDS_LOCAL_DEVELOPMENT_PATH.

config QEMU_BUILD_GIT_VERSION
	string "The version of QEMU to build"
	output yaml
	default "cxl-2023-05-19" if QEMU_BUILD_JIC23
	default "v10.1.0" if QEMU_BUILD_UPSTREAM
	help
	  This is the target build version of QEMU to build. The default
	  is v10.1.0 which is the latest stable release with full NVMe
	  support and modern compiler compatibility.

config QEMU_TARGET
	string "QEMU target architecture to build"
	output yaml
	default "aarch64-softmmu" if TARGET_ARCH_ARM64
	default "x86_64-softmmu" if TARGET_ARCH_X86_64
	default "ppc64-softmmu" if TARGET_ARCH_PPC64LE
	help
	  This is the target architecture for QEMU to build. It should match
	  the host architecture where QEMU will run.

config QEMU_USE_DEVELOPMENT_VERSION
	bool
	default y
	help
	  Internal flag automatically set when QEMU_BUILD is enabled.
	  This tells libvirt configuration to look for QEMU binaries
	  at /usr/local/bin/ where kdevops installs built QEMU.

endif # QEMU_BUILD

if !QEMU_BUILD

config QEMU_USE_DEVELOPMENT_VERSION
	bool "Are you using a manually built development version of QEMU?"
	help
	  Enable this if you built QEMU yourself (outside of kdevops) and
	  installed it to /usr/local/bin/.

	  This option tells the libvirt configuration where to find your
	  QEMU binary:
	    - If YES: /usr/local/bin/qemu-system-* (custom build location)
	    - If NO:  /usr/bin/qemu-system-* (distro package location)

	  Common scenarios for enabling this:
	    - Testing local QEMU patches before upstream submission
	    - Using QEMU features not yet in your distro's package
	    - Following your own QEMU development workflow

	  If you want kdevops to build QEMU for you instead, say N here
	  and enable QEMU_BUILD above.

endif # !QEMU_BUILD
