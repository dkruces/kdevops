# SPDX-License-Identifier: copyleft-next-0.3.1
#
# extra_vars.yaml is the union of:
#   - .extra_vars_auto.yaml (kconfig solver, via "output yaml" in Kconfig)
#   - the three ANSIBLE_EXTRA_ARGS* lists aggregated from every Makefile fragment
#   - per-module real-file fragments registered on EXTRA_VAR_FRAGMENTS
#   - late fragments registered on EXTRA_VAR_FRAGMENTS_LAST (concatenated after
#     the regular set; preserves the historical EXTRA_VAR_INPUTS_LAST ordering
#     for callers that need it, e.g. PCIE passthrough)
#
# A module contributes additional keys by writing a fragment under
# $(EXTRA_VAR_FRAGMENTS_DIR) and appending its path to EXTRA_VAR_FRAGMENTS
# (or EXTRA_VAR_FRAGMENTS_LAST).

EXTRA_VAR_FRAGMENTS_DIR := .extra_vars.d
EXTRA_VAR_FRAGMENTS :=
EXTRA_VAR_FRAGMENTS_LAST :=

null :=
space := ${null} ${null}
${space} := ${space}
comma:= ,

define YAML_ENTRY
$(1)

endef

define YAML_ENTRY_SEP
$(subst +, ,$(1))

endef

# firstword only works with spaces, so we must introduce artificial spaces
# so we capture the first entry, we peg the '=' at the end after that and
# use that to substitute $first=% / $first:%
define YAML_ENTRY_DIRECT
$(patsubst $(firstword $(subst =, ,$(1)))=%,$(firstword $(subst =, ,$(1))): "%",$(1))

endef

ROLE_DEFAULTS := $(wildcard $(KDEVOPS_PLAYBOOKS_DIR)/roles/*/defaults/main.yml)

$(EXTRA_VAR_FRAGMENTS_DIR):
	@mkdir -p $@

# Workflow Makefiles append to EXTRA_VAR_FRAGMENTS after this file is
# included, so defer prerequisite expansion via secondary expansion
# (make.texi "Secondary Expansion").
.SECONDEXPANSION:

$(KDEVOPS_EXTRA_VARS): .config $(KCONFIG_YAMLCFG) $$(EXTRA_VAR_FRAGMENTS) $$(EXTRA_VAR_FRAGMENTS_LAST) $(ROLE_DEFAULTS) | $(EXTRA_VAR_FRAGMENTS_DIR)
	@awk NF $(KCONFIG_YAMLCFG) > $(KDEVOPS_EXTRA_VARS).tmp
	@echo "# end of of yamlconfig auto output yaml variables " >> $(KDEVOPS_EXTRA_VARS).tmp
	@$(foreach exp,$(ANSIBLE_EXTRA_ARGS),echo $(call YAML_ENTRY,$(subst =,: ,$(exp)) >> $(KDEVOPS_EXTRA_VARS).tmp))
	@$(foreach exp,$(ANSIBLE_EXTRA_ARGS_SEPARATED),echo $(call YAML_ENTRY_SEP,$(subst =,: ,"$(exp)") >> $(KDEVOPS_EXTRA_VARS).tmp))
	@$(foreach exp,$(ANSIBLE_EXTRA_ARGS_DIRECT),echo $(call YAML_ENTRY_DIRECT,$(exp) >> $(KDEVOPS_EXTRA_VARS).tmp))
	@for f in $(EXTRA_VAR_FRAGMENTS) $(EXTRA_VAR_FRAGMENTS_LAST); do test -s "$$f" && cat "$$f" >> $(KDEVOPS_EXTRA_VARS).tmp || true; done
	@mv $(KDEVOPS_EXTRA_VARS).tmp $(KDEVOPS_EXTRA_VARS)
