ANSIBLE_INVENTORY_TEMPLATE_NAME := $(subst ",,$(CONFIG_ANSIBLE_INVENTORY_TEMPLATE))
ANSIBLE_INVENTORY_TEMPLATE_DIR  := $(subst ",,$(CONFIG_ANSIBLE_INVENTORY_TEMPLATE_DIR))
ANSIBLE_INVENTORY_TEMPLATE      := $(ANSIBLE_INVENTORY_TEMPLATE_DIR)/$(ANSIBLE_INVENTORY_TEMPLATE_NAME)

$(ANSIBLE_INVENTORY_FILE): .config $(ANSIBLE_CONFIG_PATH) $(ANSIBLE_INVENTORY_TEMPLATE) $(KDEVOPS_EXTRA_VARS)
	$(call run-ansible-playbook, \
		$(KDEVOPS_PLAYBOOKS_DIR)/ansible_inventory.yml \
		--extra-vars=@./extra_vars.yaml)
