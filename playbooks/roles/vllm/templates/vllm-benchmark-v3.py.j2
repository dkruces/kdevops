#!/usr/bin/env python3
# SPDX-License-Identifier: copyleft-next-0.3.1
#
# TensorMesh V3 agentic-trace replayer (kdevops in-guest runner).
#
# Replays multi-turn agent sessions from the lmcache-agentic-traces dataset
# against a vLLM OpenAI-compatible endpoint. Turns inside a session are sent
# strictly in order (preserving the prefix-growth invariant that drives
# prefix-aware KV-cache reuse / LMCache offload); sessions run concurrently
# through a fixed worker pool.
#
# Generated by kdevops. Config is substituted from Kconfig at deploy time.
import argparse
import asyncio
import csv
import json
import os
import time

import aiohttp

try:
    from datasets import load_dataset
except ImportError:
    load_dataset = None

API_URL = "http://localhost:{{ vllm_api_port | default(8000) }}"
MODEL = "{{ vllm_model_url | default('facebook/opt-125m') }}"
DATASET = "{{ vllm_benchmark_v3_dataset | default('sammshen/lmcache-agentic-traces') }}"
PRESET = "{{ vllm_benchmark_v3_preset | default('swebench-realistic') }}".strip().strip('"').strip("'")
MAX_SESSIONS = {{ vllm_benchmark_v3_max_sessions | default(0) }}
WORKERS = {{ vllm_benchmark_v3_workers | default(4) }}
RESULTS_DIR = "{{ vllm_benchmark_results_dir | default('/data/vllm-benchmark') }}"

# preset -> (source filter, timing mode, pre_gap scale)
PRESETS = {
    "default":            (None,        "respect-gaps", 1.0),
    "swebench-realistic": ("SWE-bench", "respect-gaps", 1.0),
    "swebench-burst":     ("SWE-bench", "max-pressure", 0.0),
    "gaia-burst":         ("GAIA",      "max-pressure", 0.0),
    "wildclaw-heavy":     ("WildClaw",  "respect-gaps", 1.0),
    "mixed-realistic":    (None,        "respect-gaps", 1.0),
}


def load_sessions():
    src, _, _ = PRESETS[PRESET]
    if load_dataset is None:
        raise SystemExit("python 'datasets' missing: pip install datasets pyarrow")
    ds = load_dataset(DATASET, split="train")
    by_sid = {}
    for row in ds:
        sid = row["session_id"]
        if src and not sid.startswith(src.lower()) and src.lower() not in sid.lower():
            continue
        by_sid.setdefault(sid, []).append(row)
    sessions = list(by_sid.values())
    sessions.sort(key=lambda s: s[0]["session_id"])
    if MAX_SESSIONS:
        sessions = sessions[:MAX_SESSIONS]
    # each session's turns ordered as recorded
    return sessions


async def replay_session(session, http, mode, gap_scale, sink):
    sid = session[0]["session_id"]
    for turn_idx, row in enumerate(session):
        if mode == "respect-gaps" and turn_idx > 0:
            await asyncio.sleep(float(row.get("pre_gap", 0.0)) * gap_scale)
        payload = {
            "model": MODEL,
            "messages": row["input"],
            "max_tokens": int(row.get("output_length", 64)) or 64,
            "temperature": 0.0,
            "stream": False,
        }
        t0 = time.time()
        try:
            async with http.post(f"{API_URL}/v1/chat/completions",
                                  json=payload) as r:
                ttft = time.time() - t0
                ok = r.status == 200
                body = await r.json() if ok else {}
        except Exception as exc:  # abort-on-error per session
            sink.append({"session_id": sid, "turn": turn_idx, "ok": False,
                         "latency_s": time.time() - t0, "error": str(exc)})
            return
        usage = body.get("usage", {}) if ok else {}
        sink.append({
            "session_id": sid, "turn": turn_idx, "ok": ok,
            "latency_s": round(ttft, 4),
            "prompt_tokens": usage.get("prompt_tokens"),
            "completion_tokens": usage.get("completion_tokens"),
        })
        if not ok:
            return


async def run():
    _, mode, gap_scale = PRESETS[PRESET]
    sessions = load_sessions()
    print(f"V3 preset={PRESET} sessions={len(sessions)} "
          f"workers={WORKERS} mode={mode}", flush=True)
    sink, sem = [], asyncio.Semaphore(WORKERS)
    timeout = aiohttp.ClientTimeout(total=None, sock_read=600)
    async with aiohttp.ClientSession(timeout=timeout) as http:
        async def guarded(s):
            async with sem:
                await replay_session(s, http, mode, gap_scale, sink)
        t0 = time.time()
        await asyncio.gather(*(guarded(s) for s in sessions))
        wall = time.time() - t0

    os.makedirs(RESULTS_DIR, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    base = os.path.join(RESULTS_DIR, f"v3-{PRESET}-{stamp}")
    with open(base + ".csv", "w", newline="") as f:
        cols = ["session_id", "turn", "ok", "latency_s",
                "prompt_tokens", "completion_tokens", "error"]
        w = csv.DictWriter(f, fieldnames=cols)
        w.writeheader()
        for rrow in sink:
            w.writerow({c: rrow.get(c, "") for c in cols})
    oks = [r for r in sink if r["ok"]]
    summary = {
        "preset": PRESET, "sessions": len(sessions), "turns": len(sink),
        "turns_ok": len(oks), "wall_s": round(wall, 2),
        "mean_latency_s": round(sum(r["latency_s"] for r in oks) / len(oks), 4)
        if oks else None,
    }
    with open(base + ".json", "w") as f:
        json.dump(summary, f, indent=2)
    print(json.dumps(summary, indent=2), flush=True)


if __name__ == "__main__":
    argparse.ArgumentParser().parse_args()
    asyncio.run(run())
