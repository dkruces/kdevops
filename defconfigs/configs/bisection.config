# Kconfig fragment to enable git bisection with custom script for kmod perf regression
# Usage: scripts/merge-configs.sh defconfigs/linux-modules-kpd defconfigs/configs/bisection.config
#
# This fragment configures bisection for the v6.17 -> v6.18-rc1 kmod performance regression.
# Edit CONFIG_BOOTLINUX_BISECT_REF_GOOD and CONFIG_BOOTLINUX_BISECT_REF_BAD for different ranges.

# Enable bisection
CONFIG_BOOTLINUX_BISECT_ENABLE=y

# Use custom bisection script (disable default boot script)
# CONFIG_BOOTLINUX_BISECT_SCRIPT_BOOT is not set
CONFIG_BOOTLINUX_BISECT_SCRIPT_CUSTOM=y
CONFIG_BOOTLINUX_BISECT_SCRIPT_CUSTOM_PATH="bisect-kmod-perf.sh"

# Set bisection range for kmod performance regression
CONFIG_BOOTLINUX_BISECT_REF_GOOD="v6.17"
CONFIG_BOOTLINUX_BISECT_REF_BAD="v6.18-rc1"
